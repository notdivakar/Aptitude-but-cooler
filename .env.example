# Postgres connection string. Works with Neon, Supabase, Prisma Postgres, or local Postgres.
DATABASE_URL="postgresql://user:password@localhost:5432/aptiquest"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth (optional — email/password works without these)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
